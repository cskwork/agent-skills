{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/streamdeck-agent-cockpit/cockpit.schema.json",
  "title": "Stream Deck Agent Cockpit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "server",
    "sessions",
    "commands",
    "controls"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 3
    },
    "server": {
      "$ref": "#/$defs/server"
    },
    "sessions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/session"
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/command"
      }
    },
    "controls": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/control"
      }
    },
    "appearance": {
      "$ref": "#/$defs/appearance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "tokenFile",
        "stateFile"
      ],
      "properties": {
        "host": {
          "enum": [
            "127.0.0.1",
            "localhost",
            "::1"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "tokenFile": {
          "type": "string",
          "minLength": 1
        },
        "stateFile": {
          "type": "string",
          "minLength": 1
        },
        "commandTimeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "detached": {
          "type": "boolean"
        }
      }
    },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "tmux"
            },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,80}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "probe"
          ],
          "properties": {
            "type": {
              "const": "command"
            },
            "probe": {
              "$ref": "#/$defs/command"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        }
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "staleAfterSeconds"
      ],
      "properties": {
        "source": {
          "enum": [
            "reporter",
            "adapter",
            "coarse",
            "none"
          ]
        },
        "staleAfterSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "agent",
        "adapter",
        "commands",
        "progress"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "launch": {
              "$ref": "#/$defs/command"
            },
            "focus": {
              "$ref": "#/$defs/command"
            },
            "resume": {
              "$ref": "#/$defs/command"
            },
            "interrupt": {
              "$ref": "#/$defs/command"
            }
          }
        },
        "progress": {
          "$ref": "#/$defs/progress"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "enum": [
            "focus_or_launch",
            "focus",
            "launch",
            "resume",
            "interrupt",
            "run"
          ]
        },
        "command": {
          "$ref": "#/$defs/id"
        },
        "confirmation": {
          "enum": [
            "none",
            "hold",
            "explicit"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "run"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "gestures"
      ],
      "properties": {
        "kind": {
          "enum": [
            "session",
            "command"
          ]
        },
        "session": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "gestures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "tap": {
              "$ref": "#/$defs/operation"
            },
            "longPress": {
              "$ref": "#/$defs/operation"
            },
            "dialPress": {
              "$ref": "#/$defs/operation"
            },
            "dialLeft": {
              "$ref": "#/$defs/operation"
            },
            "dialRight": {
              "$ref": "#/$defs/operation"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "session"
              }
            }
          },
          "then": {
            "required": [
              "session"
            ]
          }
        }
      ]
    },
    "appearanceState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titleSuffix": {
          "type": "string",
          "maxLength": 24
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showSource": {
          "type": "boolean"
        },
        "showAge": {
          "type": "boolean"
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/appearanceState"
          }
        }
      }
    }
  }
}
